EstIntegral_4 <- numeric(length(grid_t))
Diff_4 <- numeric(length(grid_t))
Std_Error_4 <- numeric(length(grid_t))
for (t in grid_t){
u <- runif(n)
samplex <- ((sin(pi/2*u))^t + (cos(pi/2*u))^t) * pi/2
sampley <- ((sin(pi/2*(1-u)))^t + (cos(pi/2*(1-u)))^t) * pi/2
mu_antithetic[t] <- mean((samplex+sampley)/2)
Diff_4[t] <- exact_formula_C(t) - mu_antithetic[t]
Std_Error_4[t] <- sd(0.5*(samplex+sampley))/sqrt(2*n)
}
rbind(mean_diff_4 = mean(mu_antithetic), mean_SE_4 = mean(Std_Error_4))
n <- 10^5
x <- runif(n)
y <- runif(n)
sample1 <- 4 * sin(sqrt(x^2 + y^2))/sqrt(x^2 + y^2)
sample2 <- 4 * sin(sqrt((1-x)^2 + (1-y)^2))/sqrt((1-x)^2 + (1-y)^2)
EstIntegral <- mean((sample1+sample2)/2)
Diff <- true_integral - EstIntegral
Std_Error <- sd((sample1+sample2)/2)/sqrt(n)
rbind(EstIntegral, Diff, Std_Error)
